{
  "name": "abyss-adventure",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "content": "python3 scripts/import_content.py",
    "sim": "node --import tsx packages/sim/index.ts",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "format": "prettier --write apps packages tests *.ts *.json",
    "sim:boss10": "node --import tsx packages/sim/boss10.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/node": "24.10.1",
    "apk_sign_ts": "^1.0.1",
    "fake-indexeddb": "6.2.4",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
